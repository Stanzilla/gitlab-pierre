{
  "name": "gitlab-pierre",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm typecheck && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "dev": "vite build --config vite.config.ts --watch"
  },
  "dependencies": {
    "@pierre/diffs": "1.1.22",
    "@pierre/trees": "1.0.0-beta.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/chrome": "0.1.42",
    "@types/node": "^25.7.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "8.0.13"
  }
}
