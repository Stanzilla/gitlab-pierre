{
  "manifest_version": 3,
  "name": "GitLab Pierre",
  "description": "Replace GitLab changes diffs and file tree with Pierre-powered views.",
  "version": "0.4.30",
  "content_scripts": [
    {
      "matches": [
        "*://*/*/-/merge_requests/*/diffs*",
        "*://*/*/-/commit/*",
        "*://*/*/-/compare/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["*://*/*"],
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["pierre-app.js", "*.js"],
      "matches": [
        "*://*/*/-/merge_requests/*/diffs*",
        "*://*/*/-/commit/*",
        "*://*/*/-/compare/*"
      ]
    }
  ]
}
