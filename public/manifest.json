{
  "manifest_version": 3,
  "name": "GitLab Pierre",
  "description": "Replace GitLab changes diffs and file tree with Pierre-powered views.",
  "version": "0.6.6",
  "content_scripts": [
    {
      "matches": [
        "https://*/*/-/merge_requests/*/diffs*",
        "https://*/*/-/commit/*",
        "https://*/*/-/compare/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["pierre-app.js", "*.js"],
      "matches": [
        "https://*/*/-/merge_requests/*/diffs*",
        "https://*/*/-/commit/*",
        "https://*/*/-/compare/*"
      ]
    }
  ]
}
