{
  "manifest_version": 3,
  "name": "GitLab Pierre",
  "description": "Replace GitLab changes diffs and file tree with Pierre-powered views.",
  "version": "0.4.32",
  "content_scripts": [
    {
      "matches": ["https://gitlab.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://gitlab.com/*"],
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["pierre-app.js", "*.js"],
      "matches": ["https://gitlab.com/*"]
    }
  ]
}
